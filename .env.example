# Copy to .env for local dev, or set these in Render > Environment.
PORT=3000

# Admin dashboard (/admin). Login is disabled until this is set.
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie.
SESSION_SECRET=

# Where inquiry notifications go.
NOTIFY_EMAIL=

# SMTP sender (Gmail: use an App Password). Leave blank to skip email; inquiries still save to the dashboard.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: where the SQLite file lives (use a Render persistent disk path, e.g. /var/data/fairpour.db)
DB_PATH=
